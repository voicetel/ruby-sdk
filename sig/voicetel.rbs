    end

    class NumbersMessagingCampaignUnassignData
      attr_reader campaign_id: String
      attr_reader network: String?
      attr_reader upstream_cnp_id: String?
      attr_reader unassigned_numbers: Array[String]
      attr_reader failed: Array[CampaignUnassignFailure]
      def self.build: (untyped payload) -> NumbersMessagingCampaignUnassignData?
    end

    class NumbersListData
      attr_reader numbers: Array[NumberDetail]
      def self.build: (untyped payload) -> NumbersListData?
    end

    class NumbersMessagingListData
      attr_reader numbers: Array[NumberMessagingState]
      def self.build: (untyped payload) -> NumbersMessagingListData?
    end

    class PortOutPinUpdateData
      attr_reader number: String
      attr_reader port_out_pin: String
      attr_reader changed: bool
      def self.build: (untyped payload) -> PortOutPinUpdateData?
    end

    # ---- support ----

    class TicketCreateRequest
      attr_reader subject: String
      attr_reader message: String
      attr_reader email: String?
      def initialize: (subject: String, message: String, email: String?) -> void
      def to_payload: () -> Hash[Symbol, untyped]
    end

    class TicketUpdateRequest
      attr_reader status: String
      def initialize: (status: String) -> void
      def to_payload: () -> Hash[Symbol, untyped]
    end

    class TicketReplyRequest
      attr_reader message: String
      def initialize: (message: String) -> void
      def to_payload: () -> Hash[Symbol, untyped]
    end

    class TicketSource
      attr_reader via: String?
      attr_reader type: String?
      def self.build: (untyped payload) -> TicketSource?
    end

    class TicketAction
      attr_reader text: String?
      attr_reader type: String?
      def self.build: (untyped payload) -> TicketAction?
    end

    class TicketActor
      attr_reader id: Integer?
      attr_reader type: String?
      attr_reader email: String?
      attr_reader first_name: String?
      attr_reader last_name: String?
      attr_reader photo_url: String?
      def self.build: (untyped payload) -> TicketActor?
    end

    class CustomFieldValue
      attr_reader id: Integer?
      attr_reader value: String?
      attr_reader text: String?
      def self.build: (untyped payload) -> CustomFieldValue?
    end

    class CustomerContactEntry
      attr_reader id: Integer?
      attr_reader value: String?
      attr_reader type: String?
      def self.build: (untyped payload) -> CustomerContactEntry?
    end

    class CustomerWebsiteEntry
      attr_reader id: Integer?
      attr_reader value: String?
      def self.build: (untyped payload) -> CustomerWebsiteEntry?
    end

    class CustomerAddress
      attr_reader street: String?
      attr_reader city: String?
      attr_reader state: String?
      attr_reader country: String?
      attr_reader zip: String?
      def self.build: (untyped payload) -> CustomerAddress?
    end

    class CustomerEmbedded
      attr_reader address: CustomerAddress?
      attr_reader emails: Array[CustomerContactEntry]?
      attr_reader phones: Array[CustomerContactEntry]?
      attr_reader social_profiles: Array[CustomerContactEntry]?
      attr_reader websites: Array[CustomerWebsiteEntry]?
      def self.build: (untyped payload) -> CustomerEmbedded?
    end

    class SupportAttachment
      attr_reader id: Integer?
      attr_reader mime_type: String?
      attr_reader file_name: String?
      attr_reader file_url: String?
      attr_reader size: Integer?
      def self.build: (untyped payload) -> SupportAttachment?
    end

    class ThreadEmbedded
      attr_reader attachments: Array[SupportAttachment]?
      def self.build: (untyped payload) -> ThreadEmbedded?
    end

    class ConversationEmbedded
      attr_reader threads: Array[SupportThread]?
      def self.build: (untyped payload) -> ConversationEmbedded?
    end

    class SupportCustomer
      attr_reader id: Integer?
      attr_reader first_name: String?
      attr_reader last_name: String?
      attr_reader email: String?
      attr_reader company: String?
      attr_reader job_title: String?
      attr_reader photo_type: String?
      attr_reader photo_url: String?
      attr_reader notes: String?
      attr_reader type: String?
      attr_reader created_at: String?
      attr_reader updated_at: String?
      attr_reader embedded: CustomerEmbedded?
      def self.build: (untyped payload) -> SupportCustomer?
    end

    class SupportThread
      attr_reader id: Integer?
      attr_reader status: String
      attr_reader state: String?
      attr_reader type: String?
      attr_reader body: String?
      attr_reader rating: Integer?
      attr_reader rating_comment: String?
      attr_reader opened_at: String?
      attr_reader created_at: String?
      attr_reader source: TicketSource?
      attr_reader action: TicketAction?
      attr_reader created_by: TicketActor?
      attr_reader assigned_to: TicketActor?
      attr_reader customer: SupportCustomer?
      attr_reader to: Array[String]?
      attr_reader cc: Array[String]?
      attr_reader bcc: Array[String]?
      attr_reader embedded: ThreadEmbedded?
      def self.build: (untyped payload) -> SupportThread?
    end

    class SupportConversation
      attr_reader id: Integer?
      attr_reader ticket_number: Integer?
      attr_reader status: String
      attr_reader state: String?
      attr_reader subject: String?
      attr_reader preview: String?
      attr_reader type: String?
      attr_reader mailbox_id: Integer?
      attr_reader folder_id: Integer?
      attr_reader threads_count: Integer?
      attr_reader closed_by: Integer?
      attr_reader closed_at: String?
      attr_reader created_at: String?
      attr_reader updated_at: String?
      attr_reader user_updated_at: String?
      attr_reader customer_waiting_since: Hash[untyped, untyped]?
      attr_reader source: TicketSource?
      attr_reader created_by: TicketActor?
      attr_reader assignee: TicketActor?
      attr_reader closed_by_user: TicketActor?
      attr_reader customer: SupportCustomer?
      attr_reader cc: Array[String]?
      attr_reader bcc: Array[String]?
      attr_reader custom_fields: Array[CustomFieldValue]?
      attr_reader embedded: ConversationEmbedded?
      def self.build: (untyped payload) -> SupportConversation?
    end

    class TicketData
      attr_reader ticket: SupportConversation
      def self.build: (untyped payload) -> TicketData?
    end

