# RBS type signatures for the VoiceTel Ruby SDK.
#
# Response/request models (VoiceTel::Models) are Data.define classes; they
# are declared here as plain classes with typed attr_readers (plus .build
# for responses and #to_payload for requests) rather than as < Data, which
# keeps these signatures usable across RBS versions. The public API
# (Client, Resources, ApiError) is statically typed end to end.

module VoiceTel
  VERSION: String
  API_VERSION: String
  DEFAULT_BASE_URL: String
  USER_AGENT: String

  class ApiError < StandardError
    KINDS: Array[Symbol]

    attr_reader kind: Symbol
    attr_reader status_code: Integer?
    attr_reader code: String?
    attr_reader body: untyped

    def initialize: (String message, ?kind: Symbol, ?status_code: Integer?, ?code: String?, ?body: untyped) -> void

    def bad_request?: () -> bool
    def authentication?: () -> bool
    def permission_denied?: () -> bool
    def not_found?: () -> bool
    def conflict?: () -> bool
    def rate_limit?: () -> bool
    def server?: () -> bool
    def unknown?: () -> bool

    def self.kind_from_status: (Integer) -> Symbol
    def self.from_response: (Integer status, String? code, String message, untyped body) -> ApiError
  end

  module Models
    module Base
      def self.nested: () -> Hash[Symbol, untyped]
      def self.wire_keys: () -> Hash[Symbol, String]
      def self.build: (untyped payload) -> untyped
    end

    module Request
      def to_payload: () -> Hash[Symbol, untyped]
    end

    def self.wire_key: (Symbol member) -> String
    def self.plain: (untyped value) -> untyped

    # ---- common ----

    class CidrEntry
      attr_reader cidr: String
      def self.build: (untyped payload) -> CidrEntry?
      def initialize: (cidr: String) -> void
    end

    class ErrorResponse
      attr_reader status: String?
      attr_reader code: String?
      attr_reader message: String?
      attr_reader error: String?
      attr_reader details: Hash[untyped, untyped]?
      def self.build: (untyped payload) -> ErrorResponse?
      def initialize: (status: String?, code: String?, message: String?, error: String?, details: Hash[untyped, untyped]?) -> void
    end

