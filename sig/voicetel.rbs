  end

  module Internal
    class Transport
      RETRYABLE_STATUSES: Array[Integer]
      MAX_RETRY_DELAY: Integer

      attr_reader base_url: String
      attr_reader user_agent: String
      attr_reader timeout: Integer | Float
      attr_reader max_retries: Integer
      attr_accessor api_key: String?

      def self.retry_after_seconds: (untyped value) -> Float | Integer

      def initialize: (
        base_url: String?,
        ?api_key: String?,
        ?timeout: Integer | Float,
        ?max_retries: Integer,
        ?user_agent: String?,
        ?adapter: Symbol?
      ) -> void

      def request: (
        Symbol method, String path,
        ?query: Hash[untyped, untyped]?, ?body: untyped, ?require_auth: bool
      ) -> untyped

      def camelize_keys: (untyped) -> untyped
    end
  end

  module Resources
    class Base
      def initialize: (Internal::Transport transport) -> void
      def compact_query: (Hash[untyped, untyped]) -> Hash[untyped, untyped]
      def escape_path: (untyped value) -> String
      def payload: (untyped body) -> untyped
    end

    class Account < Base
      def get: () -> Models::AccountData
      def update: (untyped body) -> Models::AccountPutData
      def add: (untyped body) -> Models::AccountAddData
      def signup: (untyped body) -> Models::AccountSignupData
      def cdr: (?start: untyped?, ?end_at: untyped?) -> Models::AccountCdrData
      def credits: (?status: String?) -> Models::AccountCreditsData
      def recurring_charges: () -> Models::AccountMrcData
      def payments: () -> Models::AccountPaymentsData
      def registration: () -> Models::AccountRegistrationData
      def recover: (untyped body) -> Models::AccountRecoverData
    end

    class Acl < Base
      def list: () -> Models::AclListData
      def add: (untyped body) -> Models::AclAddData
      def remove: (cidrs: Array[String] | String) -> Models::AclRemoveData
    end

    class Authentication < Base
      AUTH_TYPE_DIGEST: Integer
      AUTH_TYPE_LAX: Integer
      AUTH_TYPE_IP: Integer
      AUTH_TYPE_STRICT: Integer

      def get: () -> Models::AuthGetData
      def update: (untyped body) -> Models::AuthPutData
    end

    class E911 < Base
      def list: () -> Models::E911AllData
      def create: (untyped body) -> Models::E911RecordData
      def validate: (untyped body) -> Models::E911ValidateData
      def get: (String dn) -> Models::E911RecordData
      def provision: (String dn, untyped body) -> Models::E911RecordData
      def remove: (String dn) -> nil
    end

    class Gateways < Base
      def list: () -> Models::GatewaysListData
      def add: (untyped body) -> Models::GatewayEntry
      def get: (Integer id) -> Models::GatewayEntry
      def update: (Integer id, untyped body) -> Models::GatewayEntry
      def remove: (Integer id) -> nil
      def numbers: (Integer id) -> Models::GatewayNumbersData
    end

    class INumbering < Base
      def search_inventory: (
        tn_mask: String, ?quantity: Integer?, ?province: String?,
        ?rate_center: String?, ?lata: Integer?
      ) -> Models::InventorySearchData
      def coverage: (
        count_by: String, ?loc_state: String?, ?city: String?,
        ?rc_abbre: String?, ?npa: String?, ?lata: Integer?
      ) -> Models::InventoryCoverageData
      def order: (untyped body) -> Models::OrderCreateData
      def ports: () -> Models::PortListData
      def port: (String id) -> Models::PortDetailData
      def submit_port: (untyped body) -> Models::PortSubmitData
      def port_availability: (String number) -> Models::PortAvailabilityData
    end

    class Lookups < Base
      def cnam: (String number) -> Models::CnamData
      def lrn: (String number, String ani) -> Models::LrnLookupData
    end

    class Messaging < Base
      def history: (number: String, ?from: Integer?, ?to: Integer?, ?type: String?) -> Models::MessageHistoryData
      def send_message: (untyped body) -> Models::MessageSendData
      def create_brand: (untyped body) -> Models::MessagingBrandCreateData
      def campaign_status: (ids: Array[String] | String) -> Models::MessagingCampaignStatusData
      def create_campaign: (untyped body) -> Models::MessagingCampaignCreateData
      def numbers_state: (numbers: Array[String]) -> Models::NumbersMessagingListData
    end

    class Numbers < Base
      def list: () -> Models::NumbersListData
      def add: (untyped body) -> Models::NumberAddData
      def get: (String number) -> Models::NumberDetail
      def remove: (String number) -> nil
      def move: (String number, untyped body) -> Models::NumberMoveData
      def release: (String number) -> nil
      def set_route: (String number, untyped body) -> Models::NumberRouteData
      def set_translation: (String number, untyped body) -> Models::NumberTranslationData
      def set_cnam: (String number, untyped body) -> Models::NumberCnamData
      def set_lidb: (String number, untyped body) -> Models::NumberLidbData
      def get_fax: (String number) -> Models::NumberFaxData
      def set_fax: (String number, untyped body) -> Models::NumberFaxData
      def remove_fax: (String number) -> nil
      def set_forward: (String number, untyped body) -> Models::NumberForwardData
      def remove_forward: (String number) -> nil
      def get_sms: (String number) -> Models::NumberSmsData
      def set_sms: (String number, untyped body) -> Models::NumberSmsData
      def remove_sms: (String number) -> nil
      def get_messaging: (String number) -> Models::NumberMessagingState
      def patch_messaging: (String number, untyped body) -> Models::NumberMessagingPatchData
      def assign_campaign: (String number, untyped body) -> Models::NumberMessagingCampaignAssignData
      def unassign_campaign: (String number, campaign_id: String) -> Models::NumberMessagingCampaignUnassignData
      def bulk_unassign_campaign: (numbers: Array[String], campaign_id: String) -> Models::NumbersMessagingCampaignUnassignData
      def set_port_out_pin: (String number, untyped body) -> Models::PortOutPinUpdateData
    end

    class Support < Base
      def list: () -> Models::TicketsListData
      def create: (untyped body) -> Models::TicketData
      def get: (Integer id) -> Models::TicketData
      def update: (Integer id, untyped body) -> Models::TicketUpdateData
      def delete: (Integer id) -> nil
      def messages: (Integer id) -> Models::TicketThreadsData
      def reply: (Integer id, untyped body) -> Models::TicketReplyData
    end
  end

  class Client
    attr_reader transport: Internal::Transport

    def initialize: (
      ?api_key: String?, ?base_url: String?, ?timeout: Integer | Float,
      ?max_retries: Integer, ?user_agent: String?, ?adapter: Symbol?
    ) -> void

    def login: (username: String, password: String) -> String
    def api_key: () -> String?
    def base_url: () -> String

    def account: () -> Resources::Account
    def acl: () -> Resources::Acl
    def authentication: () -> Resources::Authentication
    def e911: () -> Resources::E911
    def gateways: () -> Resources::Gateways
    def i_numbering: () -> Resources::INumbering
    def lookups: () -> Resources::Lookups
    def messaging: () -> Resources::Messaging
    def numbers: () -> Resources::Numbers
    def support: () -> Resources::Support
  end
end
